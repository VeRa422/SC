<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Кот в мешке — гадость</title>
<style>
  :root {
    --night:#170d23;
    --night2:#2a1238;
    --orange:#ff7a24;
    --amber:#ffb52e;
    --gold:#ffd56a;
    --cream:#fff1c7;
    --paper:#e8bd76;
    --ink:#2f160e;
  }
  *{box-sizing:border-box}
  html,body{margin:0;min-height:100%;background:#130a1d;color:#fff}
  body{
    font-family: Georgia, "Times New Roman", serif;
    overflow-x:hidden;
    background:
      radial-gradient(circle at 78% 12%, rgba(255,174,46,.22), transparent 24%),
      radial-gradient(circle at 15% 65%, rgba(255,83,24,.18), transparent 26%),
      linear-gradient(180deg,var(--night2),var(--night));
  }

  .page{
    min-height:100vh;
    display:grid;
    place-items:center;
    padding:22px;
    position:relative;
    isolation:isolate;
  }
  .page:before{
    content:"";
    position:fixed;
    inset:0;
    z-index:-3;
    background:
      linear-gradient(180deg,rgba(16,6,28,.06),rgba(15,6,22,.55)),
      url("data:image/jpeg;base64,") center/cover no-repeat;
    filter:saturate(1.14) brightness(.72);
  }
  .page:after{
    content:"";
    position:fixed;
    inset:0;
    z-index:-2;
    background:
      radial-gradient(circle at 78% 10%, rgba(255,190,60,.14), transparent 23%),
      linear-gradient(90deg, rgba(16,5,24,.28), rgba(16,5,24,.10) 45%, rgba(16,5,24,.28));
    backdrop-filter: blur(2px);
  }

  .leaf{
    position:fixed;
    width:18px;height:11px;
    background:linear-gradient(135deg,#ffb338,#d93b1c);
    border-radius:80% 0 80% 0;
    opacity:.74;
    z-index:-1;
    animation:fall linear infinite;
    transform:rotate(30deg);
  }
  .l1{left:8%;top:-20px;animation-duration:11s}
  .l2{left:28%;top:-30px;animation-duration:13s;animation-delay:2s}
  .l3{left:62%;top:-18px;animation-duration:10s;animation-delay:4s}
  .l4{left:86%;top:-26px;animation-duration:14s;animation-delay:1s}
  @keyframes fall{
    to{transform:translate(90px,110vh) rotate(500deg)}
  }

  .shell{
    width:min(960px,100%);
    border:1px solid rgba(255,208,105,.45);
    border-radius:28px;
    overflow:hidden;
    box-shadow:0 28px 80px rgba(0,0,0,.52);
    background:rgba(34,12,38,.9);
    backdrop-filter:blur(12px);
    position:relative;
  }
  .shell:before{
    content:"";
    position:absolute;
    inset:9px;
    border:1px solid rgba(255,195,73,.24);
    border-radius:20px;
    pointer-events:none;
    z-index:10;
  }

  .hero{
    position:relative;
    min-height:285px;
    padding:34px 38px 26px 42%;
    display:flex;
    flex-direction:column;
    justify-content:center;
    overflow:hidden;
    border-bottom:1px solid rgba(255,204,100,.22);
  }
  .hero:before{
    content:"";
    position:absolute;inset:0;
    background:
      linear-gradient(90deg,rgba(23,7,28,.06) 0 34%,rgba(23,7,28,.70) 52%,rgba(23,7,28,.90) 100%),
      url("data:image/jpeg;base64,") center/cover no-repeat;
    z-index:-1;
  }
  .hero:after{
    content:"";
    position:absolute;
    inset:auto 0 0 0;
    height:60px;
    background:linear-gradient(transparent,rgba(32,10,35,.93));
    pointer-events:none;
  }
  .eyebrow{
    display:inline-flex;
    align-items:center;
    gap:8px;
    align-self:flex-start;
    padding:8px 13px;
    border-radius:999px;
    background:rgba(40,11,39,.72);
    border:1px solid rgba(255,196,75,.42);
    color:#ffe4a5;
    font:700 14px/1.1 system-ui, sans-serif;
    letter-spacing:.04em;
    text-transform:uppercase;
    box-shadow:0 8px 24px rgba(0,0,0,.22);
  }
  h1{
    margin:14px 0 6px;
    font-size:clamp(40px,6vw,72px);
    line-height:.95;
    color:#ffe8a5;
    text-shadow:0 3px 0 #7b2b14,0 0 24px rgba(255,177,47,.32);
  }
  .lead{
    margin:8px 0 0;
    max-width:560px;
    font-size:clamp(17px,2.2vw,24px);
    line-height:1.35;
    color:#fff5da;
    text-shadow:0 2px 8px rgba(0,0,0,.55);
  }
  .lead b{color:#ffd56a}

  .content{padding:26px}
  .note{
    margin:0 auto 16px;
    width:max-content;
    max-width:100%;
    padding:10px 15px;
    border-radius:14px;
    background:rgba(255,239,200,.10);
    border:1px solid rgba(255,210,111,.24);
    color:#ffe8b5;
    font:600 15px/1.2 system-ui,sans-serif;
    text-align:center;
  }

  .scratch-frame{
    position:relative;
    max-width:780px;
    margin:0 auto;
    padding:15px;
    border-radius:28px;
    background:
      linear-gradient(135deg,rgba(255,164,44,.26),rgba(104,35,96,.24)),
      rgba(27,8,31,.75);
    border:1px solid rgba(255,197,80,.38);
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.04),0 18px 50px rgba(0,0,0,.34);
  }
  .scratch{
    position:relative;
    width:100%;
    aspect-ratio:16/9;
    overflow:hidden;
    border-radius:20px;
    border:1px solid rgba(255,220,130,.25);
    background:#2a112d;
  }

  .prize{
    position:absolute;inset:0;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:30px;
    color:var(--ink);
    background:
      radial-gradient(circle at 50% 14%,rgba(255,255,255,.38),transparent 20%),
      repeating-linear-gradient(0deg,rgba(105,50,10,.045) 0 1px,transparent 1px 5px),
      linear-gradient(135deg,#f7d68f,#e8b765 46%,#f6d18a);
  }
  .prize:before{
    content:"";
    position:absolute;inset:14px;
    border:2px solid rgba(95,36,13,.42);
    border-radius:15px;
    box-shadow:inset 0 0 0 5px rgba(255,236,181,.30);
    pointer-events:none;
  }
  .prize .tiny{
    position:relative;
    z-index:1;
    font:700 15px/1.1 system-ui,sans-serif;
    letter-spacing:.12em;
    text-transform:uppercase;
    color:#6a260f;
  }
  .prize .surprise{
    position:relative;z-index:1;
    margin:8px 0 -4px;
    font-size:clamp(28px,4.7vw,46px);
    color:#3d170e;
  }
  .prize .five{
    position:relative;z-index:1;
    margin:0;
    font-size:clamp(76px,14vw,138px);
    line-height:.88;
    font-weight:700;
    color:#9b2d13;
    text-shadow:0 3px 0 #ffd978;
  }
  .prize .caption{
    position:relative;z-index:1;
    margin-top:10px;
    font-size:clamp(18px,2.6vw,27px);
    font-weight:700;
    color:#4b1b0d;
  }
  .prize .joke{
    position:relative;z-index:1;
    margin-top:14px;
    font:700 15px/1.2 system-ui,sans-serif;
    color:#7b2b10;
    background:rgba(255,248,214,.42);
    border:1px solid rgba(105,41,11,.18);
    padding:8px 14px;
    border-radius:999px;
  }

  #prizeCanvas,#cover{
    position:absolute;inset:0;
    width:100%;height:100%;
  }
  #prizeCanvas{
    z-index:1;
    pointer-events:none;
  }
  #cover{
    z-index:2;
    touch-action:none;
    cursor:crosshair;
    user-select:none;
    -webkit-user-select:none;
  }

  .progress{
    margin-top:13px;
    text-align:center;
    color:#f7d8a2;
    font:600 14px/1.2 system-ui,sans-serif;
  }
  .done{
    display:none;
    margin:12px auto 0;
    width:max-content;
    max-width:100%;
    padding:10px 15px;
    border-radius:999px;
    background:linear-gradient(180deg,#ffcc63,#f39a31);
    color:#421508;
    font:800 15px/1.1 system-ui,sans-serif;
    box-shadow:0 8px 20px rgba(0,0,0,.25);
  }
  .done.show{display:block;animation:pop .35s ease both}
  @keyframes pop{from{transform:scale(.86);opacity:0}to{transform:scale(1);opacity:1}}

  .reset{
    display:block;
    margin:15px auto 0;
    border:1px solid rgba(255,207,112,.25);
    background:rgba(255,255,255,.06);
    color:#ffe8b8;
    border-radius:13px;
    padding:9px 14px;
    font:600 14px system-ui,sans-serif;
    cursor:pointer;
  }
  .reset:hover{background:rgba(255,255,255,.10)}

  .footer{
    padding:0 26px 24px;
    text-align:center;
    color:#cdb58b;
    font:14px/1.4 system-ui,sans-serif;
  }

  @media(max-width:720px){
    .page{padding:10px}
    .hero{
      min-height:370px;
      padding:210px 22px 24px;
      text-align:center;
      align-items:center;
    }
    .hero:before{
      background:
        linear-gradient(180deg,rgba(23,7,28,.02) 0 44%,rgba(23,7,28,.82) 68%,rgba(23,7,28,.95) 100%),
        url("data:image/jpeg;base64,") 16% center/cover no-repeat;
    }
    .eyebrow{align-self:center}
    .content{padding:18px 12px}
    .scratch-frame{padding:9px;border-radius:21px}
    .scratch{border-radius:16px}
    .prize{padding:16px}
    .prize .joke{font-size:12px}
  }
</style>
</head>
<body>
<div class="leaf l1"></div><div class="leaf l2"></div><div class="leaf l3"></div><div class="leaf l4"></div>

<main class="page">
  <section class="shell">
    <header class="hero">
      <div class="eyebrow">😈 Мария выбрала «ГАДОСТЬ»</div>
      <h1>Кот в мешке</h1>
      <p class="lead">
        Смелый выбор принят. Теперь <b>сотрите защитный слой</b> и узнайте,
        какую гадость приготовил чёрный кот 🐈‍⬛
      </p>
    </header>

    <div class="content">
      <div class="note">✨ Стирайте мышкой или пальцем — под слоем спрятан ваш бонус</div>

      <div class="scratch-frame">
        <div class="scratch" id="scratch">
          <canvas id="prizeCanvas" aria-label="Бонус: плюс 5 процентов дополнительной скидки"></canvas>
          <canvas id="cover" aria-label="Скретч-слой. Сотрите его мышкой или пальцем"></canvas>
        </div>

        <div class="progress" id="progress">Сотрите слой, чтобы открыть сюрприз.</div>
        <div class="done" id="done">🎁 Бонус открыт: +5% к скидке</div>
        <button class="reset" id="reset" type="button">Спрятать снова</button>
      </div>
    </div>

    <div class="footer">«Страшно интересно» · сюрприз для победителя</div>
  </section>
</main>

<script>
(() => {
  const cover = document.getElementById('cover');
  const prize = document.getElementById('prizeCanvas');
  const scratch = document.getElementById('scratch');
  const progress = document.getElementById('progress');
  const done = document.getElementById('done');
  const reset = document.getElementById('reset');
  const cctx = cover.getContext('2d', {willReadFrequently:true});
  const pctx = prize.getContext('2d');

  let drawing = false;
  let last = null;
  let opened = false;
  let checkTimer = 0;
  let dpr = 1;
  const threshold = 24;

  function rr(ctx,x,y,w,h,r){
    const m=Math.min(r,w/2,h/2);
    ctx.beginPath();
    ctx.moveTo(x+m,y);
    ctx.arcTo(x+w,y,x+w,y+h,m);
    ctx.arcTo(x+w,y+h,x,y+h,m);
    ctx.arcTo(x,y+h,x,y,m);
    ctx.arcTo(x,y,x+w,y,m);
    ctx.closePath();
  }

  function setFont(ctx, weight, size, family='Georgia'){
    ctx.font=`${weight} ${Math.max(10,size)}px ${family}`;
  }

  function drawPrize(w,h){
    pctx.setTransform(dpr,0,0,dpr,0,0);
    pctx.clearRect(0,0,w,h);

    const g=pctx.createLinearGradient(0,0,w,h);
    g.addColorStop(0,'#f9df9f');
    g.addColorStop(.48,'#e5ad56');
    g.addColorStop(1,'#f6d486');
    pctx.fillStyle=g;
    pctx.fillRect(0,0,w,h);

    // parchment texture
    pctx.globalAlpha=.10;
    for(let i=0;i<85;i++){
      pctx.fillStyle = i%2 ? '#7d3518' : '#fff5c8';
      pctx.beginPath();
      pctx.arc(Math.random()*w,Math.random()*h,Math.random()*2.1+.4,0,Math.PI*2);
      pctx.fill();
    }
    pctx.globalAlpha=1;

    pctx.strokeStyle='rgba(92,36,13,.55)';
    pctx.lineWidth=2;
    rr(pctx,13,13,w-26,h-26,18); pctx.stroke();
    pctx.strokeStyle='rgba(255,246,205,.50)';
    pctx.lineWidth=1;
    rr(pctx,20,20,w-40,h-40,14); pctx.stroke();

    pctx.textAlign='center';
    pctx.textBaseline='middle';

    pctx.fillStyle='#7b2b13';
    setFont(pctx,700,Math.min(18,w*.024),'Arial');
    pctx.fillText('ГАДОСТЬ ОТ КОТА',w/2,h*.16);

    pctx.fillStyle='#3e170d';
    setFont(pctx,700,Math.min(38,w*.052));
    pctx.fillText('Ну что, испугались? 😼',w/2,h*.30);

    pctx.fillStyle='#a33115';
    pctx.shadowColor='rgba(122,42,12,.18)';
    pctx.shadowBlur=8;
    pctx.shadowOffsetY=3;
    setFont(pctx,700,Math.min(118,w*.16));
    pctx.fillText('+5%',w/2,h*.52);
    pctx.shadowColor='transparent';

    pctx.fillStyle='#4a1b0d';
    setFont(pctx,700,Math.min(28,w*.038));
    pctx.fillText('дополнительной скидки',w/2,h*.69);

    const pillW=Math.min(w*.72,520), pillH=Math.max(34,h*.11);
    pctx.fillStyle='rgba(255,248,216,.55)';
    rr(pctx,(w-pillW)/2,h*.77,pillW,pillH,pillH/2); pctx.fill();
    pctx.strokeStyle='rgba(99,39,12,.20)'; pctx.stroke();
    pctx.fillStyle='#74280f';
    setFont(pctx,700,Math.min(17,w*.023),'Arial');
    pctx.fillText('Вот такая гадость. Сладости зубы портят 😈',w/2,h*.77+pillH/2);
  }

  function drawCover(w,h){
    cctx.setTransform(dpr,0,0,dpr,0,0);
    cctx.globalCompositeOperation='source-over';
    cctx.clearRect(0,0,w,h);

    const g=cctx.createLinearGradient(0,0,w,h);
    g.addColorStop(0,'#5d5362');
    g.addColorStop(.45,'#756a78');
    g.addColorStop(1,'#47404f');
    cctx.fillStyle=g;
    cctx.fillRect(0,0,w,h);

    // metallic speckles
    for(let i=0;i<95;i++){
      cctx.fillStyle=`rgba(255,231,174,${.05+Math.random()*.18})`;
      cctx.beginPath();
      cctx.arc(Math.random()*w,Math.random()*h,Math.random()*2.3+.35,0,Math.PI*2);
      cctx.fill();
    }

    cctx.strokeStyle='rgba(255,225,167,.32)';
    cctx.lineWidth=2;
    rr(cctx,12,12,w-24,h-24,17); cctx.stroke();

    cctx.textAlign='center';
    cctx.textBaseline='middle';
    cctx.fillStyle='#fff2cd';
    setFont(cctx,700,Math.min(34,w*.047));
    cctx.fillText('СОТРИТЕ СЛОЙ',w/2,h*.46);
    cctx.fillStyle='#ffe0a3';
    setFont(cctx,600,Math.min(19,w*.026));
    cctx.fillText('мышкой или пальцем',w/2,h*.58);

    cctx.fillStyle='rgba(255,225,160,.20)';
    setFont(cctx,400,Math.min(40,w*.056),'Arial');
    cctx.fillText('✦',w*.18,h*.23);
    cctx.fillText('✦',w*.82,h*.78);
    cctx.fillText('✦',w*.81,h*.22);
    cctx.fillText('✦',w*.19,h*.79);
  }

  function fit(){
    const r=scratch.getBoundingClientRect();
    dpr=Math.max(1,Math.min(2,window.devicePixelRatio||1));
    for(const cv of [prize,cover]){
      cv.width=Math.round(r.width*dpr);
      cv.height=Math.round(r.height*dpr);
      cv.style.width=r.width+'px';
      cv.style.height=r.height+'px';
    }
    drawPrize(r.width,r.height);
    drawCover(r.width,r.height);
    opened=false; drawing=false; last=null;
    cover.style.transition='none';
    cover.style.opacity='1';
    cover.style.pointerEvents='auto';
    done.classList.remove('show');
    progress.textContent='Сотрите слой, чтобы открыть сюрприз.';
  }

  function point(e){
    const r=cover.getBoundingClientRect();
    return {x:e.clientX-r.left,y:e.clientY-r.top};
  }

  function eraseTo(p){
    cctx.save();
    cctx.globalCompositeOperation='destination-out';
    cctx.lineCap='round';
    cctx.lineJoin='round';
    const radius=Math.max(30,cover.getBoundingClientRect().width*.045);
    cctx.strokeStyle='#000';
    cctx.fillStyle='#000';
    cctx.lineWidth=radius*1.55;
    if(last){
      cctx.beginPath();
      cctx.moveTo(last.x,last.y);
      cctx.lineTo(p.x,p.y);
      cctx.stroke();
    }
    cctx.beginPath();
    cctx.arc(p.x,p.y,radius,0,Math.PI*2);
    cctx.fill();
    cctx.restore();
    last=p;
  }

  function revealedPercent(){
    const data=cctx.getImageData(0,0,cover.width,cover.height).data;
    let clear=0,checked=0;
    const jump=32;
    for(let i=3;i<data.length;i+=4*jump){
      checked++;
      if(data[i]<32) clear++;
    }
    return checked ? Math.round(clear/checked*100) : 0;
  }

  function evaluate(){
    checkTimer=0;
    if(opened) return;
    const pct=revealedPercent();
    progress.textContent=`Открыто: ${pct}%`;
    if(pct>=threshold){
      opened=true;
      drawing=false;
      progress.textContent='Гадость раскрыта 😼';
      done.classList.add('show');
      cover.style.transition='opacity .38s ease';
      cover.style.opacity='0';
      setTimeout(()=>{cover.style.pointerEvents='none';},400);
      confetti();
    }
  }

  function scheduleEvaluate(){
    if(checkTimer) return;
    checkTimer=setTimeout(evaluate,110);
  }

  function down(e){
    if(opened) return;
    drawing=true;
    last=null;
    try{ cover.setPointerCapture(e.pointerId); }catch(_){ }
    eraseTo(point(e));
    scheduleEvaluate();
    e.preventDefault();
  }
  function move(e){
    if(!drawing||opened) return;
    eraseTo(point(e));
    scheduleEvaluate();
    e.preventDefault();
  }
  function up(e){
    if(!drawing) return;
    drawing=false; last=null;
    try{ cover.releasePointerCapture(e.pointerId); }catch(_){ }
    evaluate();
  }

  function confetti(){
    for(let i=0;i<20;i++){
      const s=document.createElement('span');
      s.textContent=Math.random()>.45?'✨':'🍁';
      Object.assign(s.style,{
        position:'fixed',left:(45+Math.random()*10)+'vw',top:(45+Math.random()*12)+'vh',
        zIndex:9999,pointerEvents:'none',fontSize:(15+Math.random()*18)+'px',opacity:'1',
        transition:'transform 1s ease-out,opacity 1s ease-out'
      });
      document.body.appendChild(s);
      requestAnimationFrame(()=>{
        s.style.transform=`translate(${(Math.random()-.5)*300}px,${(Math.random()-.5)*240}px) rotate(${Math.random()*420}deg)`;
        s.style.opacity='0';
      });
      setTimeout(()=>s.remove(),1100);
    }
  }

  cover.addEventListener('pointerdown',down,{passive:false});
  cover.addEventListener('pointermove',move,{passive:false});
  cover.addEventListener('pointerup',up,{passive:false});
  cover.addEventListener('pointercancel',up,{passive:false});
  cover.addEventListener('contextmenu',e=>e.preventDefault());

  reset.addEventListener('click',fit);

  let resizeTimer=0;
  window.addEventListener('resize',()=>{
    clearTimeout(resizeTimer);
    resizeTimer=setTimeout(fit,120);
  });
  fit();
})();
</script>
</body>
</html>
